{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WholeEarthEntry",
  "type": "object",
  "required": [
    "id",
    "volume",
    "kind",
    "title_en"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "volume": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "tool",
        "article",
        "review",
        "letter",
        "ad",
        "other"
      ]
    },
    "page_start": {
      "type": "integer"
    },
    "page_end": {
      "type": "integer"
    },
    "title_en": {
      "type": "string"
    },
    "title_zh": {
      "type": "string"
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "body_en": {
      "type": "string",
      "description": "Full English text, not abridged"
    },
    "body_zh": {
      "type": "string",
      "description": "Full Chinese translation, not abridged"
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "figures": {
      "type": "array",
      "description": "Keep every illustration with the entry",
      "items": {
        "type": "object",
        "required": [
          "id",
          "ia_image_url"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "page": {
            "type": "integer"
          },
          "caption_en": {
            "type": "string"
          },
          "caption_zh": {
            "type": "string"
          },
          "ia_image_url": {
            "type": "string"
          },
          "local_path": {
            "type": "string",
            "description": "Optional local copy after rights allow"
          }
        }
      }
    },
    "see_also": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "volume": {
            "type": "string"
          },
          "entry_id": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "archive_id": {
          "type": "string"
        },
        "ia_page": {
          "type": "string"
        },
        "wholeearth_url": {
          "type": "string"
        }
      }
    }
  }
}
